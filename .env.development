# Development Environment Variables
# Used when running 'npm run dev' locally

# Local Backend URL
VITE_API_BASE_URL=http://localhost:5000

# Wompi Payment Configuration (Sandbox)
# Get these from your Wompi Dashboard > Developers > API Keys
WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_BASE=https://sandbox.wompi.co/v1

# Email Configuration (Gmail)
# Use an App Password if 2FA is enabled: https://myaccount.google.com/apppasswords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
